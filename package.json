{
  "name": "codecloud",
  "version": "0.1.0",
  "description": "Open-source hands-on DevOps lab platform: courses, browser terminals, disposable lab containers and auto-graded tasks.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "codecloud": "./src/cli.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "vitest run",
    "test:docker": "CODECLOUD_DOCKER_TESTS=1 vitest run test/docker.integration.test.js",
    "validate-content": "node src/cli.js validate"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/session": "^11.1.5",
    "@fastify/static": "^10.1.6",
    "@fastify/websocket": "^11.3.4",
    "@node-rs/argon2": "^2.2.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "dockerode": "^5.0.1",
    "fastify": "^5.12.7",
    "marked": "^18.1.1",
    "sanitize-html": "^2.18.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "vitest": "^5.0.5",
    "ws": "^8.22.0"
  }
}
